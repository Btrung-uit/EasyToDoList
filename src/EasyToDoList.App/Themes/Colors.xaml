<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="GuildInkColor">#2A1B14</Color>
    <Color x:Key="GuildInkMutedColor">#654A36</Color>
    <Color x:Key="GuildParchmentColor">#F6E2B9</Color>
    <Color x:Key="GuildParchmentDeepColor">#E9C98F</Color>
    <Color x:Key="GuildWoodColor">#3A2418</Color>
    <Color x:Key="GuildWoodLightColor">#694228</Color>
    <Color x:Key="GuildCreamColor">#FFF2D0</Color>
    <Color x:Key="GuildGoldColor">#E2A93B</Color>
    <Color x:Key="GuildGoldPressedColor">#C98B24</Color>
    <Color x:Key="GuildMossColor">#526A3A</Color>
    <Color x:Key="GuildDangerColor">#9B3F32</Color>
    <Color x:Key="GuildDisabledColor">#9A876E</Color>

    <SolidColorBrush x:Key="GuildInkBrush" Color="{StaticResource GuildInkColor}" />
    <SolidColorBrush x:Key="GuildInkMutedBrush" Color="{StaticResource GuildInkMutedColor}" />
    <SolidColorBrush x:Key="GuildParchmentBrush" Color="{StaticResource GuildParchmentColor}" />
    <SolidColorBrush x:Key="GuildParchmentDeepBrush" Color="{StaticResource GuildParchmentDeepColor}" />
    <SolidColorBrush x:Key="GuildWoodBrush" Color="{StaticResource GuildWoodColor}" />
    <SolidColorBrush x:Key="GuildWoodLightBrush" Color="{StaticResource GuildWoodLightColor}" />
    <SolidColorBrush x:Key="GuildCreamBrush" Color="{StaticResource GuildCreamColor}" />
    <SolidColorBrush x:Key="GuildGoldBrush" Color="{StaticResource GuildGoldColor}" />
    <SolidColorBrush x:Key="GuildGoldPressedBrush" Color="{StaticResource GuildGoldPressedColor}" />
    <SolidColorBrush x:Key="GuildMossBrush" Color="{StaticResource GuildMossColor}" />
    <SolidColorBrush x:Key="GuildDangerBrush" Color="{StaticResource GuildDangerColor}" />
    <SolidColorBrush x:Key="GuildDisabledBrush" Color="{StaticResource GuildDisabledColor}" />
</ResourceDictionary>
