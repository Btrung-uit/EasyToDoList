<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GuildFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2"
                               Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                               StrokeThickness="2"
                               StrokeDashArray="2 1"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuildButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GuildParchmentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildWoodBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource GuildInkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource GuildUiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GuildFocusVisualStyle}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="{StaticResource GuildControlPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GuildInkBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GuildGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GuildInkBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GuildGoldPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource GuildDisabledBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuildWoodButtonStyle" TargetType="Button"
           BasedOn="{StaticResource GuildButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GuildWoodLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildGoldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}" />
    </Style>

    <Style x:Key="GuildDangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource GuildButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GuildDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildCreamBrush}" />
        <Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}" />
    </Style>

    <Style x:Key="GuildPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GuildParchmentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildWoodBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="{StaticResource GuildPanelPadding}" />
    </Style>

    <Style x:Key="GuildPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource GuildButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GuildGoldBrush}"/>
    </Style>
    <Style x:Key="GuildNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource GuildButtonStyle}">
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
            <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock x:Name="Label" Margin="8,0,0,0" Text="{Binding}"/>
            </StackPanel>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsCompactDashboard, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompactDashboard, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GuildProgressStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource GuildMossBrush}"/>
        <Setter Property="Background" Value="{StaticResource GuildParchmentDeepBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
            <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                <Border x:Name="PART_Track"/>
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource GuildButtonStyle}" />
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GuildFocusVisualStyle}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GuildFocusVisualStyle}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GuildFocusVisualStyle}" />
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GuildFocusVisualStyle}" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    </Style>
</ResourceDictionary>
