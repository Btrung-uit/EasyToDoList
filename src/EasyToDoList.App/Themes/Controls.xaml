<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="GuildFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2"
                               Stroke="{StaticResource GuildGoldBrush}"
                               StrokeThickness="2"
                               StrokeDashArray="2 1"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuildButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GuildParchmentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildWoodBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource GuildInkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource GuildUiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GuildFocusVisualStyle}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="{StaticResource GuildControlPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GuildInkBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GuildGoldBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource GuildInkBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GuildGoldPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource GuildDisabledBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuildWoodButtonStyle" TargetType="Button"
           BasedOn="{StaticResource GuildButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GuildWoodLightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildGoldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}" />
    </Style>

    <Style x:Key="GuildDangerButtonStyle" TargetType="Button"
           BasedOn="{StaticResource GuildButtonStyle}">
        <Setter Property="Background" Value="{StaticResource GuildDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildCreamBrush}" />
        <Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}" />
    </Style>

    <Style x:Key="GuildPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GuildParchmentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GuildWoodBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="{StaticResource GuildPanelPadding}" />
    </Style>
</ResourceDictionary>
