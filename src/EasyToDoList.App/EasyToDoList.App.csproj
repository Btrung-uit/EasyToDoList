<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Resource Include="..\..\assets\branding\easytodolist-logo.png">
      <Link>Assets\Branding\easytodolist-logo.png</Link>
    </Resource>
    <Resource Include="..\..\assets\branding\easytodolist.ico">
      <Link>Assets\Branding\easytodolist.ico</Link>
    </Resource>
    <EmbeddedResource Include="..\..\assets\branding\easytodolist.ico" LogicalName="Branding.AppIcon" />
    <EmbeddedResource Include="..\..\assets\audio\*.wav">
      <LogicalName>Audio.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Resource Include="..\..\assets\pixel-art\mvp\mascots\knight\frames\**\*.png">
      <Link>Assets\Mascots\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Resource>
    <Resource Include="..\..\assets\pixel-art\mvp\ambient\**\*.png" Exclude="..\..\assets\pixel-art\mvp\ambient\ambient-atlas.png">
      <Link>Assets\Ambient\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Resource>
    <ProjectReference Include="..\EasyToDoList.Core\EasyToDoList.Core.csproj" />
    <ProjectReference Include="..\EasyToDoList.Infrastructure\EasyToDoList.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\pixel-art\mvp\backgrounds\guild-valley.png">
      <Link>Assets\Backgrounds\guild-valley.png</Link>
    </Resource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\assets\branding\easytodolist.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
