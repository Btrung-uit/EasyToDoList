<Window x:Class="EasyToDoList.App.MainWindow"
        x:Name="AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:EasyToDoList.App.Shell" xmlns:today="clr-namespace:EasyToDoList.App.Features.Today"
        xmlns:presentation="clr-namespace:EasyToDoList.App.Presentation"
        mc:Ignorable="d"
        Title="EasyToDoList — Hội quán nhiệm vụ"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GuildWoodBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing" MouseEnter="OnWindowInteractionChanged" MouseLeave="OnWindowInteractionChanged"
        IsKeyboardFocusWithinChanged="OnFocusChanged" PreviewKeyDown="OnKeyboardInteraction" PreviewMouseDown="OnMouseInteraction">
    <Grid RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Grid.Background>
            <ImageBrush ImageSource="/EasyToDoList.App;component/Assets/Backgrounds/guild-valley.png" Stretch="UniformToFill" />
        </Grid.Background>
        <Border Background="#3D182319" />
        <presentation:GuildScene x:Name="AmbientScene" />

        <ScrollViewer x:Name="DashboardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static shell:ShellDisplayMode.Dashboard}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
        <Grid MinWidth="1144" MinHeight="664"
              Width="{Binding ViewportWidth, ElementName=DashboardScroll}"
              Height="{Binding ViewportHeight, ElementName=DashboardScroll}">
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,12"
                    Background="{StaticResource GuildWoodBrush}"
                    BorderBrush="{StaticResource GuildGoldBrush}"
                    BorderThickness="3" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource GuildDisplayTextStyle}" Text="HỘI QUÁN NHIỆM VỤ" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource GuildWoodBodyTextStyle}"
                                   Text="Lập kế hoạch hôm nay, giữ nhịp tập trung và tiến bước như một mạo hiểm giả." />
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GuildPanelStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource GuildHeadingTextStyle}" Text="Sổ hành trình" />
                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Today" Content="Hôm nay" Style="{StaticResource GuildButtonStyle}" />
                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Calendar" Content="Lịch sử" Style="{StaticResource GuildButtonStyle}" />
                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Pomodoro" Content="Pomodoro" Style="{StaticResource GuildButtonStyle}" />
                        <Button Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Settings" Content="Cài đặt" Style="{StaticResource GuildButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GuildPanelStyle}">
                    <ContentControl Content="{Binding Dashboard.Current}" />
                </Border>

                <Border Grid.Column="4" Padding="20"
                        Background="{StaticResource GuildWoodBrush}"
                        BorderBrush="{StaticResource GuildGoldBrush}"
                        BorderThickness="3" CornerRadius="5">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GuildCreamBrush}" Text="Mạo hiểm giả" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource GuildWoodBodyTextStyle}">
                            <Run Text="Hạng " /><Run Text="{Binding Dashboard.Profile.Progress.Rank, Mode=OneWay}" /><Run Text=" · Cấp " /><Run Text="{Binding Dashboard.Profile.Progress.Level, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource GuildWoodBodyTextStyle}"><Run Text="EXP " /><Run Text="{Binding Dashboard.Profile.Progress.TotalExperience, Mode=OneWay}" /><Run Text=" · Coin " /><Run Text="{Binding Dashboard.Profile.Coins, Mode=OneWay}" /></TextBlock>
                        <presentation:GuildScene x:Name="MascotScene" Height="160" MascotOnly="True" />
                        <Border Height="2" Margin="0,20" Background="{StaticResource GuildGoldBrush}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GuildCreamBrush}" Text="Pomodoro" />
                        <Button Command="{Binding ShowOverlayCommand}"
                                CommandParameter="{x:Static shell:OverlayMode.Pomodoro}"
                                Margin="0,12,0,0" Content="Thu gọn thành Overlay"
                                Style="{StaticResource GuildButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>

        <Border x:Name="OverlayFrame" Margin="4" Padding="6" VerticalAlignment="Top"
                Background="{StaticResource GuildWoodBrush}"
                BorderBrush="{StaticResource GuildGoldBrush}"
                BorderThickness="2" CornerRadius="5"
                MouseLeftButtonDown="OnOverlayMouseLeftButtonDown">
            <Border.Resources>
                <Style x:Key="OverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource GuildButtonStyle}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </Border.Resources>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static shell:ShellDisplayMode.Overlay}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ShowOverlayCommand}"
                            CommandParameter="{x:Static shell:OverlayMode.Todo}"
                            Content="Việc cần làm" Style="{StaticResource OverlayButtonStyle}" />
                    <Button Grid.Column="2" Command="{Binding ShowOverlayCommand}"
                            CommandParameter="{x:Static shell:OverlayMode.Pomodoro}"
                            Content="Pomodoro" Style="{StaticResource OverlayButtonStyle}" />
                </Grid>

                <Border Grid.Row="2" Padding="6" BorderThickness="2" Style="{StaticResource GuildPanelStyle}">
                    <Grid>
                        <Grid MinHeight="40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayMode}" Value="{x:Static shell:OverlayMode.Todo}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ListBox AutomationProperties.Name="Nhiệm vụ trong Overlay" MaxHeight="144" ItemsSource="{Binding Dashboard.Today.Items}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <today:CompletionSurface Progress="{Binding CompletionProgress}"><Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <Button Grid.Column="1" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.Dashboard.Today.CompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Content="Xong"
                                                    Style="{StaticResource OverlayButtonStyle}" />
                                        </Grid></today:CompletionSurface>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Style="{StaticResource GuildBodyTextStyle}"
                                       Text="Không còn nhiệm vụ nào cho hôm nay."
                                       Visibility="{Binding Dashboard.Today.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayMode}" Value="{x:Static shell:OverlayMode.Pomodoro}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,6" HorizontalAlignment="Center"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource GuildInkBrush}"
                                       Text="{Binding PomodoroOverlay.TimeText}">
                                <AutomationProperties.Name><MultiBinding StringFormat="{}{0}, {1}"><Binding Path="PomodoroOverlay.PhaseLabel"/><Binding Path="PomodoroOverlay.TimeText"/></MultiBinding></AutomationProperties.Name>
                            </TextBlock>
                            <Grid>
                                <Button Width="160" HorizontalAlignment="Center" Command="{Binding PomodoroOverlay.StartCommand}"
                                        Visibility="{Binding PomodoroOverlay.CanStart, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="Bắt đầu" Style="{StaticResource OverlayButtonStyle}" />
                                <UniformGrid Columns="2" Visibility="{Binding PomodoroOverlay.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Margin="0,0,4,0" Command="{Binding PomodoroOverlay.PauseCommand}" Content="Tạm dừng" Style="{StaticResource OverlayButtonStyle}" />
                                    <Button Margin="4,0,0,0" Command="{Binding PomodoroOverlay.SkipCommand}" Content="Bỏ qua" Style="{StaticResource OverlayButtonStyle}" />
                                </UniformGrid>
                                <UniformGrid Columns="2" Visibility="{Binding PomodoroOverlay.IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Margin="0,0,4,0" Command="{Binding PomodoroOverlay.ResumeCommand}" Content="Tiếp tục" Style="{StaticResource OverlayButtonStyle}" />
                                    <Button Margin="4,0,0,0" Command="{Binding PomodoroOverlay.StopCommand}" Content="Dừng" Style="{StaticResource OverlayButtonStyle}" />
                                </UniformGrid>
                            </Grid>
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource GuildDangerBrush}"
                                       Text="{Binding PomodoroOverlay.ErrorMessage}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding PomodoroOverlay.ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ShowDashboardCommand}" Content="Mở Dashboard" Style="{StaticResource OverlayButtonStyle}" />
                    <Button Grid.Column="2" Command="{Binding HideToTrayCommand}" Content="Ẩn" Style="{StaticResource GuildWoodButtonStyle}" MinHeight="32" FontSize="12" Padding="8,4" />
                </Grid>
            </Grid>
        </Border>

        <Border Margin="24"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource GuildDangerBrush}"
                BorderBrush="{StaticResource GuildCreamBrush}"
                BorderThickness="2"
                CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExitErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock MaxWidth="520"
                       Foreground="{StaticResource GuildCreamBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding ExitErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>
        <Popup x:Name="OverlayFeedbackPopup" PlacementTarget="{Binding ElementName=AppWindow}"
               Placement="Custom" Width="320" AllowsTransparency="True" StaysOpen="True">
            <Popup.Style>
                <Style TargetType="Popup">
                    <Setter Property="IsOpen" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DisplayMode}" Value="{x:Static shell:ShellDisplayMode.Overlay}"/>
                                <Condition Binding="{Binding Dashboard.Today.HasFeedback}" Value="True"/>
                                <Condition Binding="{Binding IsVisible, ElementName=AppWindow}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsOpen" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Popup.Style>
            <today:CompletionFeedbackView DataContext="{Binding Dashboard.Today}"
                MouseEnter="OnWindowInteractionChanged" MouseLeave="OnWindowInteractionChanged"
                IsKeyboardFocusWithinChanged="OnFocusChanged" PreviewKeyDown="OnKeyboardInteraction" PreviewMouseDown="OnMouseInteraction"/>
        </Popup>
        <Canvas>
        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
              Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
        <Grid DataContext="{Binding Dashboard.Today}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    MaxWidth="340" Panel.ZIndex="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="16" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Static shell:ShellDisplayMode.Overlay}">
                            <Setter Property="Margin" Value="16,16,16,64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource GuildCreamBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            <today:CompletionFeedbackView Grid.Row="1">
                <today:CompletionFeedbackView.Style>
                    <Style TargetType="today:CompletionFeedbackView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static shell:ShellDisplayMode.Dashboard}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </today:CompletionFeedbackView.Style>
            </today:CompletionFeedbackView>
        </Grid>
        </Grid>
        </Canvas>
    </Grid>
</Window>
