<Window x:Class="EasyToDoList.App.MainWindow"
        x:Name="AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:EasyToDoList.App.Shell" xmlns:today="clr-namespace:EasyToDoList.App.Features.Today"
        xmlns:presentation="clr-namespace:EasyToDoList.App.Presentation"
        mc:Ignorable="d"
        Title="EasyToDoList — Hội quán nhiệm vụ"
        Icon="/EasyToDoList.App;component/Assets/Branding/easytodolist.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GuildWoodBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing" MouseEnter="OnWindowInteractionChanged" MouseLeave="OnWindowInteractionChanged"
        IsKeyboardFocusWithinChanged="OnFocusChanged" PreviewKeyDown="OnKeyboardInteraction" PreviewMouseDown="OnMouseInteraction">
    <Grid RenderOptions.BitmapScalingMode="NearestNeighbor">
        <Grid.Background>
            <ImageBrush ImageSource="/EasyToDoList.App;component/Assets/Backgrounds/guild-valley.png" Stretch="UniformToFill" />
        </Grid.Background>
        <Border Background="#3D182319" />
        <presentation:GuildScene x:Name="AmbientScene" />

        <ScrollViewer x:Name="DashboardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static shell:ShellDisplayMode.Dashboard}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
        <Grid MinWidth="840" MinHeight="520"
              Width="{Binding ViewportWidth, ElementName=DashboardScroll}"
              Height="{Binding ViewportHeight, ElementName=DashboardScroll}">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,6"
                    Background="{StaticResource GuildWoodBrush}"
                    BorderBrush="{StaticResource GuildGoldBrush}"
                    BorderThickness="3" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="52" Height="52" Margin="0,0,12,0" Stretch="Uniform"
                           Source="/EasyToDoList.App;component/Assets/Branding/easytodolist-logo.png"
                           AutomationProperties.Name="Logo EasyToDoList — Hội Quản Nhiệm Vụ" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource GuildCreamBrush}" Text="HỘI QUẢN NHIỆM VỤ" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource GuildWoodBodyTextStyle}"
                                   Text="Mỗi nhiệm vụ là một bước phiêu lưu." />
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavigationColumn" Width="176" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="224" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GuildPanelStyle}" Padding="10,16">
                    <StackPanel>
                        <TextBlock x:Name="NavigationHeading" Margin="4,0,0,16" FontSize="16" FontWeight="SemiBold" Text="Sổ hành trình"/>                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Today" Content="Hôm nay" Tag="M 2,2 L 14,2 14,14 2,14 Z M 5,5 L 11,5 M 5,8 L 11,8 M 5,11 L 9,11" ToolTip="Hôm nay" AutomationProperties.Name="Hôm nay">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GuildNavigationButtonStyle}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Dashboard.SelectedSection}" Value="Today"><Setter Property="Background" Value="{StaticResource GuildWoodLightBrush}"/><Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}"/><Setter Property="AutomationProperties.ItemStatus" Value="Đang chọn"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Calendar" Content="Lịch sử" Tag="M 2,4 L 14,4 14,14 2,14 Z M 2,7 L 14,7 M 5,1 L 5,5 M 11,1 L 11,5" ToolTip="Lịch sử" AutomationProperties.Name="Lịch sử">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GuildNavigationButtonStyle}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Dashboard.SelectedSection}" Value="Calendar"><Setter Property="Background" Value="{StaticResource GuildWoodLightBrush}"/><Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}"/><Setter Property="AutomationProperties.ItemStatus" Value="Đang chọn"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Pomodoro" Content="Pomodoro" Tag="M 8,3 A 6,6 0 1 0 8,15 A 6,6 0 1 0 8,3 M 8,5 L 8,9 11,9 M 5,1 L 11,1" ToolTip="Pomodoro" AutomationProperties.Name="Pomodoro">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GuildNavigationButtonStyle}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Dashboard.SelectedSection}" Value="Pomodoro"><Setter Property="Background" Value="{StaticResource GuildWoodLightBrush}"/><Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}"/><Setter Property="AutomationProperties.ItemStatus" Value="Đang chọn"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>                        <Button Margin="0,0,0,8" Command="{Binding Dashboard.NavigateCommand}" CommandParameter="Settings" Content="Cài đặt" Tag="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12 M 5,2 L 5,6 M 11,6 L 11,10 M 6,10 L 6,14" ToolTip="Cài đặt" AutomationProperties.Name="Cài đặt">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GuildNavigationButtonStyle}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Dashboard.SelectedSection}" Value="Settings"><Setter Property="Background" Value="{StaticResource GuildWoodLightBrush}"/><Setter Property="Foreground" Value="{StaticResource GuildCreamBrush}"/><Setter Property="AutomationProperties.ItemStatus" Value="Đang chọn"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GuildPanelStyle}" Padding="20,16">
                    <ContentControl Content="{Binding Dashboard.Current}" />
                </Border>

                <Border Grid.Column="4" Padding="16" Background="{StaticResource GuildWoodBrush}" BorderBrush="{StaticResource GuildGoldBrush}" BorderThickness="3" CornerRadius="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GuildCreamBrush}" Text="Mạo hiểm giả"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GuildCreamBrush}">
                            <Run Text="Hạng "/><Run Text="{Binding Dashboard.Profile.Progress.Rank, Mode=OneWay}"/><Run Text=" · Cấp "/><Run Text="{Binding Dashboard.Profile.Progress.Level, Mode=OneWay}"/>
                        </TextBlock>
                        <presentation:GuildScene x:Name="MascotScene" Height="116" MascotOnly="True"/>
                        <TextBlock Style="{StaticResource GuildWoodBodyTextStyle}"><Run Text="EXP: "/><Run Text="{Binding Dashboard.Profile.Progress.ExperienceIntoLevel, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Dashboard.Profile.Progress.ExperienceRequiredForNextLevel, Mode=OneWay}"/></TextBlock>
                        <ProgressBar Margin="0,8,0,12" Height="8" Style="{StaticResource GuildProgressStyle}" Foreground="{StaticResource GuildGoldBrush}" Value="{Binding Dashboard.Profile.Progress.ExperienceIntoLevel, Mode=OneWay}" Maximum="{Binding Dashboard.Profile.Progress.ExperienceRequiredForNextLevel}" AutomationProperties.Name="EXP đến cấp tiếp theo"/>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform" Fill="{StaticResource GuildGoldBrush}" Data="M 4,0 L 12,0 16,4 16,12 12,16 4,16 0,12 0,4 Z"/>
                            <TextBlock Style="{StaticResource GuildWoodBodyTextStyle}"><Run Text="Coin: "/><Run Text="{Binding Dashboard.Profile.Coins, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Dashboard.Profile.ErrorMessage}" Foreground="{StaticResource GuildCreamBrush}" TextWrapping="Wrap"/>
                        <Border Height="1" Margin="0,20" Background="{StaticResource GuildGoldBrush}"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource GuildCreamBrush}" Text="Pomodoro"/>
                        <TextBlock Margin="0,8,0,4" FontSize="32" FontWeight="Bold" Foreground="{StaticResource GuildCreamBrush}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding PomodoroOverlay.TimeText}"/><Style.Triggers><DataTrigger Binding="{Binding PomodoroOverlay.HasSession}" Value="False"><Setter Property="Text" Value="{Binding Dashboard.Pomodoro.FocusMinutes, StringFormat={}{0:00}:00}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource GuildWoodBodyTextStyle}" Text="{Binding PomodoroOverlay.PhaseLabel}"/>
                        <TextBlock Style="{StaticResource GuildWoodBodyTextStyle}" Text="{Binding PomodoroOverlay.StatusLabel}" TextWrapping="Wrap"/>
                        <Button Margin="0,12,0,0" Content="Bắt đầu" Command="{Binding PomodoroOverlay.StartCommand}" Visibility="{Binding PomodoroOverlay.CanStart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Margin="0,12,0,0" Content="Tạm dừng" Command="{Binding PomodoroOverlay.PauseCommand}" Visibility="{Binding PomodoroOverlay.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Margin="0,12,0,0" Content="Tiếp tục" Command="{Binding PomodoroOverlay.ResumeCommand}" Visibility="{Binding PomodoroOverlay.IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding PomodoroOverlay.ErrorMessage}" Foreground="{StaticResource GuildCreamBrush}" TextWrapping="Wrap"/>
                        <Button Command="{Binding ShowOverlayCommand}" CommandParameter="{x:Static shell:OverlayMode.Pomodoro}" Margin="0,8,0,0" Content="Mở cửa sổ tập trung" Style="{StaticResource GuildWoodButtonStyle}" ToolTip="Hiển thị Pomodoro trong Overlay luôn nổi" Padding="8,6"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>

        <Border x:Name="OverlayFrame" Margin="4" Padding="6" VerticalAlignment="Top"
                Background="{StaticResource GuildWoodBrush}"
                BorderBrush="{StaticResource GuildGoldBrush}"
                BorderThickness="2" CornerRadius="5"
                MouseLeftButtonDown="OnOverlayMouseLeftButtonDown">
            <Border.Resources>
                <Style x:Key="OverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource GuildButtonStyle}">
                    <Setter Property="MinHeight" Value="32" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </Border.Resources>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static shell:ShellDisplayMode.Overlay}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ShowOverlayCommand}"
                            CommandParameter="{x:Static shell:OverlayMode.Todo}"
                            Content="Việc cần làm" Style="{StaticResource OverlayButtonStyle}" />
                    <Button Grid.Column="2" Command="{Binding ShowOverlayCommand}"
                            CommandParameter="{x:Static shell:OverlayMode.Pomodoro}"
                            Content="Pomodoro" Style="{StaticResource OverlayButtonStyle}" />
                </Grid>

                <Border Grid.Row="2" Padding="6" BorderThickness="2" Style="{StaticResource GuildPanelStyle}">
                    <Grid>
                        <Grid MinHeight="40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayMode}" Value="{x:Static shell:OverlayMode.Todo}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ListBox AutomationProperties.Name="Nhiệm vụ trong Overlay" MaxHeight="144" ItemsSource="{Binding Dashboard.Today.Items}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <today:CompletionSurface Progress="{Binding CompletionProgress}"><Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <Button Grid.Column="1" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.Dashboard.Today.CompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Content="Xong"
                                                    Style="{StaticResource OverlayButtonStyle}" />
                                        </Grid></today:CompletionSurface>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Style="{StaticResource GuildBodyTextStyle}"
                                       Text="Không còn nhiệm vụ nào cho hôm nay."
                                       Visibility="{Binding Dashboard.Today.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayMode}" Value="{x:Static shell:OverlayMode.Pomodoro}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,6" HorizontalAlignment="Center"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource GuildInkBrush}"
                                       Text="{Binding PomodoroOverlay.TimeText}">
                                <AutomationProperties.Name><MultiBinding StringFormat="{}{0}, {1}"><Binding Path="PomodoroOverlay.PhaseLabel"/><Binding Path="PomodoroOverlay.TimeText"/></MultiBinding></AutomationProperties.Name>
                            </TextBlock>
                            <Grid>
                                <Button Width="160" HorizontalAlignment="Center" Command="{Binding PomodoroOverlay.StartCommand}"
                                        Visibility="{Binding PomodoroOverlay.CanStart, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Content="Bắt đầu" Style="{StaticResource OverlayButtonStyle}" />
                                <UniformGrid Columns="2" Visibility="{Binding PomodoroOverlay.IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Margin="0,0,4,0" Command="{Binding PomodoroOverlay.PauseCommand}" Content="Tạm dừng" Style="{StaticResource OverlayButtonStyle}" />
                                    <Button Margin="4,0,0,0" Command="{Binding PomodoroOverlay.SkipCommand}" Content="Bỏ qua" Style="{StaticResource OverlayButtonStyle}" />
                                </UniformGrid>
                                <UniformGrid Columns="2" Visibility="{Binding PomodoroOverlay.IsPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Margin="0,0,4,0" Command="{Binding PomodoroOverlay.ResumeCommand}" Content="Tiếp tục" Style="{StaticResource OverlayButtonStyle}" />
                                    <Button Margin="4,0,0,0" Command="{Binding PomodoroOverlay.StopCommand}" Content="Dừng" Style="{StaticResource OverlayButtonStyle}" />
                                </UniformGrid>
                            </Grid>
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource GuildDangerBrush}"
                                       Text="{Binding PomodoroOverlay.ErrorMessage}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                    <DataTrigger Binding="{Binding PomodoroOverlay.ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ShowDashboardCommand}" Content="Mở Dashboard" Style="{StaticResource OverlayButtonStyle}" />
                    <Button Grid.Column="2" Command="{Binding HideToTrayCommand}" Content="Ẩn" Style="{StaticResource GuildWoodButtonStyle}" MinHeight="32" FontSize="12" Padding="8,4" />
                </Grid>
            </Grid>
        </Border>

        <Border Margin="24"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource GuildDangerBrush}"
                BorderBrush="{StaticResource GuildCreamBrush}"
                BorderThickness="2"
                CornerRadius="3">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ExitErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock MaxWidth="520"
                       Foreground="{StaticResource GuildCreamBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding ExitErrorMessage}"
                       TextWrapping="Wrap" />
        </Border>
        <Popup x:Name="OverlayFeedbackPopup" PlacementTarget="{Binding ElementName=AppWindow}"
               Placement="Custom" Width="320" AllowsTransparency="True" StaysOpen="True">
            <Popup.Style>
                <Style TargetType="Popup">
                    <Setter Property="IsOpen" Value="False"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DisplayMode}" Value="{x:Static shell:ShellDisplayMode.Overlay}"/>
                                <Condition Binding="{Binding Dashboard.Today.HasFeedback}" Value="True"/>
                                <Condition Binding="{Binding IsVisible, ElementName=AppWindow}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="IsOpen" Value="True"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Popup.Style>
            <today:CompletionFeedbackView DataContext="{Binding Dashboard.Today}"
                MouseEnter="OnWindowInteractionChanged" MouseLeave="OnWindowInteractionChanged"
                IsKeyboardFocusWithinChanged="OnFocusChanged" PreviewKeyDown="OnKeyboardInteraction" PreviewMouseDown="OnMouseInteraction"/>
        </Popup>
        <Canvas>
        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
              Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
        <Grid DataContext="{Binding Dashboard.Today}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    MaxWidth="340" Panel.ZIndex="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="16" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Static shell:ShellDisplayMode.Overlay}">
                            <Setter Property="Margin" Value="16,16,16,64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel>
                <Border Background="{StaticResource GuildWoodBrush}" BorderBrush="{StaticResource GuildGoldBrush}" BorderThickness="2" Padding="12" Margin="0,0,0,8">
                    <Border.Style><Style TargetType="Border"><Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static shell:ShellDisplayMode.Overlay}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource GuildCreamBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource GuildCreamBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
            <today:CompletionFeedbackView Grid.Row="1">
                <today:CompletionFeedbackView.Style>
                    <Style TargetType="today:CompletionFeedbackView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static shell:ShellDisplayMode.Dashboard}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </today:CompletionFeedbackView.Style>
            </today:CompletionFeedbackView>
        </Grid>
        </Grid>
        </Canvas>
    </Grid>
</Window>
