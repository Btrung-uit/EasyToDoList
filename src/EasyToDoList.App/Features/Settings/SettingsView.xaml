<UserControl x:Class="EasyToDoList.App.Features.Settings.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="500"><TextBlock Style="{StaticResource GuildHeadingTextStyle}" Text="Cài đặt"/><TextBlock Margin="0,14,0,4" Text="Âm lượng tổng"/><Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding MasterVolume}"/><CheckBox Margin="0,12,0,0" IsChecked="{Binding CompletionSoundEnabled}" Content="Âm thanh hoàn thành"/><CheckBox IsChecked="{Binding ComboSoundEnabled}" Content="Âm thanh combo"/><CheckBox IsChecked="{Binding TickSoundEnabled}" Content="Tiếng tick Pomodoro"/><CheckBox IsChecked="{Binding BellSoundEnabled}" Content="Tiếng chuông"/><CheckBox Margin="0,12,0,0" IsChecked="{Binding AnimationsEnabled}" Content="Bật animation"/><CheckBox IsChecked="{Binding ReducedMotionEnabled}" Content="Giảm chuyển động"/><CheckBox Margin="0,12,0,0" IsChecked="{Binding PomodoroNotificationsEnabled}" Content="Thông báo Pomodoro"/><CheckBox IsChecked="{Binding DueNotificationsEnabled}" Content="Thông báo đến hạn"/><CheckBox IsChecked="{Binding OverdueNotificationsEnabled}" Content="Thông báo trễ hạn"/><CheckBox IsChecked="{Binding AutoStartEnabled}" Content="Khởi động cùng Windows"/><Button Margin="0,16,0,0" Command="{Binding SaveCommand}" Content="Lưu cài đặt" Style="{StaticResource GuildButtonStyle}"/><TextBlock Margin="0,8,0,0" Text="{Binding StatusMessage}"/></StackPanel></ScrollViewer></UserControl>
