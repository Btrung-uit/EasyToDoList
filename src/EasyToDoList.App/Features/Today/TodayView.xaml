<UserControl x:Class="EasyToDoList.App.Features.Today.TodayView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN" FontSize="14">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Style="{StaticResource GuildHeadingTextStyle}" Text="Nhiệm vụ hôm nay"/>
      <TextBlock Margin="0,4,0,12" Foreground="{StaticResource GuildInkMutedBrush}" Text="{Binding DateLabel}"/>
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"/><TextBlock Text="{Binding ProgressLabel}"/></DockPanel>
      <ProgressBar Margin="0,8,0,0" Height="8" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Style="{StaticResource GuildProgressStyle}" AutomationProperties.Name="Tiến độ nhiệm vụ hôm nay"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,16,0,12">
      <TextBlock Text="Tên nhiệm vụ" Margin="0,0,0,4"/>
      <Grid>
        <TextBox x:Name="TitleInput" MinHeight="44" FontSize="15" AutomationProperties.Name="Tên nhiệm vụ" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nhập tên và nhấn Enter để thêm nhanh">
          <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SaveCommand}"/></TextBox.InputBindings>
        </TextBox>
        <TextBlock Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource GuildInkMutedBrush}" Text="Hôm nay bạn muốn hoàn thành điều gì?" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <TextBlock Foreground="{StaticResource GuildDangerBrush}" Text="{Binding TitleError}" TextWrapping="Wrap"/>
      <Expander Header="Ngày bắt đầu và hạn chót" IsExpanded="{Binding ScheduleExpanded}" Margin="0,6,0,8">
        <StackPanel>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Ngày bắt đầu" Margin="0,0,0,4"/><DatePicker AutomationProperties.Name="Ngày bắt đầu" SelectedDate="{Binding StartDate}" SelectedDateFormat="Short"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Hạn chót" Margin="0,0,0,4"/><DatePicker AutomationProperties.Name="Hạn chót" SelectedDate="{Binding Deadline}" SelectedDateFormat="Short"/></StackPanel>
          </Grid>
          <TextBlock Foreground="{StaticResource GuildDangerBrush}" Text="{Binding DeadlineError}" TextWrapping="Wrap"/>
        </StackPanel>
      </Expander>
      <Button Command="{Binding SaveCommand}" Style="{StaticResource GuildPrimaryButtonStyle}">
        <Button.Content><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="+ Thêm nhiệm vụ"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Text" Value="Lưu thay đổi"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content>
      </Button>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource GuildDangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Nhiệm vụ hôm nay" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="0">
        <ListBox.ItemTemplate><DataTemplate>
          <Border Background="{StaticResource GuildCreamBrush}" TextElement.Foreground="{StaticResource GuildInkBrush}" BorderBrush="{StaticResource GuildParchmentDeepBrush}" BorderThickness="1" Padding="10" Margin="0,4">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" IsChecked="{Binding IsCompleting, Mode=OneWay}" Checked="OnCompleteChecked" AutomationProperties.Name="{Binding Title, StringFormat=Hoàn thành: {0}}" ToolTip="Hoàn thành nhiệm vụ; có thể Hoàn tác trong thông báo">
                  <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompleting}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                  </Style.Triggers></Style></CheckBox.Style>
                </CheckBox>
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleting}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{StaticResource GuildMossBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </DockPanel>
              <DockPanel Margin="24,4,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button MinHeight="32" Padding="8,2" Margin="8,0,0,0" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Content="Sửa" ToolTip="Chỉnh sửa tên và lịch nhiệm vụ"/>
                  <Button MinHeight="32" Padding="8,2" Margin="8,0,0,0" Click="OnCancelTask" Content="Hủy" ToolTip="Hủy nhiệm vụ và giữ trong lịch sử"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center"><TextBlock FontSize="12" Text="{Binding Deadline, StringFormat=Hạn {0:dd/MM/yyyy}}"/><TextBlock FontSize="12" Text="{Binding StatusLabel}" Foreground="{StaticResource GuildInkMutedBrush}"/></StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" Focusable="False" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
        <Image Height="56" Width="56" Source="/EasyToDoList.App;component/Assets/Mascots/idle/idle-00.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <TextBlock Margin="0,8,0,6" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Hành trình hôm nay đã hoàn thành!"/><Style.Triggers><DataTrigger Binding="{Binding CompletedCount}" Value="0"><Setter Property="Text" Value="Hành trình hôm nay chưa bắt đầu!"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GuildInkMutedBrush}">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Tuyệt lắm, mạo hiểm giả! Bạn có thể nghỉ ngơi hoặc tạo nhiệm vụ tiếp theo."/><Style.Triggers><DataTrigger Binding="{Binding CompletedCount}" Value="0"><Setter Property="Text" Value="Mạo hiểm giả, hãy tạo nhiệm vụ đầu tiên để bắt đầu cuộc phiêu lưu!"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Button Margin="0,12,0,0" Content="+ Tạo nhiệm vụ đầu tiên" Click="OnFocusTitle"/>
      </StackPanel>
      </ScrollViewer>
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Đang tải nhiệm vụ…" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
  </Grid>
</UserControl>
