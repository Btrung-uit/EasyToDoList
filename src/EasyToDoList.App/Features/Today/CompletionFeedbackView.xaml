<UserControl x:Class="EasyToDoList.App.Features.Today.CompletionFeedbackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:EasyToDoList.App.Features.Today">
 <Border Padding="12" Background="{StaticResource GuildWoodBrush}" BorderBrush="{StaticResource GuildGoldBrush}" BorderThickness="2" CornerRadius="5"
         Visibility="{Binding HasFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image Width="36" Height="36" Source="{Binding MascotFrame}" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Hiệp sĩ chúc mừng hoàn thành"/>
    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ComboLabel}" Style="{StaticResource GuildWoodBodyTextStyle}"/>
    <local:ComboRing Grid.Column="2" Width="24" Height="24" Progress="{Binding ComboProgress}" AutomationProperties.Name="Cửa sổ combo 2 giây"
                     Visibility="{Binding IsComboActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   </Grid>
   <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Feedback}"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource GuildWoodBodyTextStyle}" ToolTip="{Binding Message}" AutomationProperties.Name="{Binding Message}" AutomationProperties.LiveSetting="Polite"/>
      <Button Grid.Column="1" Margin="8,0,0,0" Content="Hoàn tác" Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Hoàn tác trong 5 giây sau khi hoàn thành" AutomationProperties.Name="Hoàn tác nhiệm vụ vừa hoàn thành" Style="{StaticResource GuildWoodButtonStyle}"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
