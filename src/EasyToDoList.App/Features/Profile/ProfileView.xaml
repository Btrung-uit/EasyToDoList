<UserControl x:Class="EasyToDoList.App.Features.Profile.ProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource GuildHeadingTextStyle}" Text="Hồ sơ mạo hiểm giả"/><TextBlock Margin="0,8"><Run Text="Hạng "/><Run Text="{Binding Progress.Rank, Mode=OneWay}"/><Run Text=" · Cấp "/><Run Text="{Binding Progress.Level, Mode=OneWay}"/><Run Text=" · EXP "/><Run Text="{Binding Progress.TotalExperience, Mode=OneWay}"/><Run Text=" · Coin "/><Run Text="{Binding Coins, Mode=OneWay}"/></TextBlock></StackPanel><TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource GuildDangerBrush}" Text="{Binding ErrorMessage}"/><DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Rewards}"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtUtc}"/><DataGridTextColumn Header="Nguồn" Binding="{Binding SourceType}"/><DataGridTextColumn Header="Lý do" Binding="{Binding Reason}"/><DataGridTextColumn Header="EXP" Binding="{Binding ExperienceDelta}"/><DataGridTextColumn Header="Coin" Binding="{Binding CoinDelta}"/></DataGrid.Columns></DataGrid></DockPanel></UserControl>
