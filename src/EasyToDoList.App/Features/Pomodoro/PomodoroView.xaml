<UserControl x:Class="EasyToDoList.App.Features.Pomodoro.PomodoroView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel MaxWidth="420">
  <TextBlock Style="{StaticResource GuildHeadingTextStyle}" Text="Nhịp Pomodoro"/>
  <TextBlock Margin="0,12,0,8" Text="Chọn nhịp tập trung / nghỉ ngắn (phút)" TextWrapping="Wrap"/>
  <UniformGrid Columns="3">
   <Button Margin="0,0,4,0" Content="25/5" Command="{Binding SelectPresetCommand}" CommandParameter="25/5" Style="{StaticResource GuildButtonStyle}" AutomationProperties.Name="25 phút tập trung, 5 phút nghỉ"/>
   <Button Margin="4,0" Content="45/10" Command="{Binding SelectPresetCommand}" CommandParameter="45/10" Style="{StaticResource GuildButtonStyle}" AutomationProperties.Name="45 phút tập trung, 10 phút nghỉ"/>
   <Button Margin="4,0,0,0" Content="50/10" Command="{Binding SelectPresetCommand}" CommandParameter="50/10" Style="{StaticResource GuildButtonStyle}" AutomationProperties.Name="50 phút tập trung, 10 phút nghỉ"/>
  </UniformGrid>
  <TextBlock Margin="0,10,0,16" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
   <TextBlock.Text><MultiBinding StringFormat="Đang chọn: {0} phút tập trung / {1} phút nghỉ"><Binding Path="FocusMinutes"/><Binding Path="ShortBreakMinutes"/></MultiBinding></TextBlock.Text>
  </TextBlock>
  <Expander Header="Cài đặt nâng cao" AutomationProperties.Name="Cài đặt nâng cao Pomodoro">
   <StackPanel>
    <TextBlock Margin="0,12,0,4" Text="Tập trung (15–60 phút)"/>
    <TextBox AutomationProperties.Name="Tập trung, 15 đến 60 phút" Text="{Binding FocusMinutes}"/>
    <TextBlock Margin="0,10,0,4" Text="Nghỉ ngắn (20–30% thời gian tập trung)"/>
    <TextBox AutomationProperties.Name="Nghỉ ngắn, 20 đến 30 phần trăm thời gian tập trung" Text="{Binding ShortBreakMinutes}"/>
    <TextBlock Margin="0,10,0,4" Text="Nghỉ dài (15–30 phút)"/>
    <TextBox AutomationProperties.Name="Nghỉ dài, 15 đến 30 phút" Text="{Binding LongBreakMinutes}"/>
    <TextBlock Margin="0,10,0,4" Text="Nghỉ dài sau 3 hoặc 4 phiên"/>
    <TextBox AutomationProperties.Name="Nghỉ dài sau 3 hoặc 4 phiên" Text="{Binding LongBreakInterval}"/>
    <Button Margin="0,16,0,0" Command="{Binding ValidateCommand}" Content="Kiểm tra cấu hình" Style="{StaticResource GuildButtonStyle}"/>
   </StackPanel>
  </Expander>
  <TextBlock Margin="0,8,0,0" Foreground="{StaticResource GuildDangerBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
