<UserControl x:Class="EasyToDoList.App.Features.Calendar.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Command="{Binding PreviousWeekCommand}" Content="Tuần trước"/><TextBlock Margin="16,6" FontWeight="SemiBold" Text="{Binding WeekLabel}"/><Button Command="{Binding NextWeekCommand}" Content="Tuần sau"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource GuildDangerBrush}" Text="{Binding ErrorMessage}"/><DataGrid Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Entries}"><DataGrid.Columns><DataGridTextColumn Header="Ngày" Binding="{Binding Date}"/><DataGridTextColumn Header="Nhiệm vụ" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></DockPanel></UserControl>
